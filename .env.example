# ====================================================================
# Aletheia Environment Configuration Template
# Copy this file to .env and insert your API keys
# ====================================================================

# Google Gemini API Key (Required for LLM reasoning & Multimodal Vision OCR)
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# GNews API Key (Required for live global news search)
# Get a key at: https://gnews.io/
GNEWS_API_KEY=your_gnews_api_key_here

# Demo Mode (Set to True to force simulated benchmark feeds without consuming API quotas)
DEMO_MODE=False

# Langfuse Observability (Optional, for multi-agent LLM execution tracing)
# Get keys at: https://cloud.langfuse.com/
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Optional local Tesseract executable path (defaults to standard Windows directories)
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
